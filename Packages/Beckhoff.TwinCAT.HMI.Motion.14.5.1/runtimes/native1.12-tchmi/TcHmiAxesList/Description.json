            "description": "String with the exact name of the NC Runtime on port 500. You can configure the runtime in Server > ADS > Runtimes. \nThe NC Runtime is not optional.",
            "readOnly": false,
            "bindable": true,
            "heritable": true,
            "defaultValue": "NC",
            "defaultValueInternal": ""
        },
        {
            "name": "data-tchmi-nc-task",
            "propertyName": "NcTask",
            "propertySetterName": "setNcTask",
            "propertyGetterName": "getNcTask",
            "displayName": "NC Task",
            "visible": true,
            "type": "tchmi:general#/definitions/String",
            "themeable": "Standard",
            "category": "Common",
            "description": "String with the exact name of the NC-Task Runtime on Port 501. You can configure the runtime in Server > ADS > Runtimes. \nThe NC-Task Runtime is not optional.",
            "readOnly": false,
            "bindable": true,
            "heritable": true,
            "defaultValue": "NC-Task1",
            "defaultValueInternal": ""
        },
        {
            "name": "data-tchmi-target-motion-control",
            "propertyName": "TargetMotionControl",
            "propertySetterName": "setTargetMotionControl",
            "propertyGetterName": "getTargetMotionControl",
            "displayName": "Target Motion Control",
            "visible": true,
            "type": "tchmi:framework#/definitions/TcHmi.Controls.System.TcHmiControl",
            "themeable": "Standard",
            "category": "Common",
            "description": "Reference to a TcHmiMotionControl. When an axis is selected in the list and the referenced control uses the data source mode 'NC' and the axis is part of its allowed axes, that axis is selected in the referenced control automatically.",
            "readOnly": false,
            "bindable": true,
            "heritable": true,
            "defaultValue": null,
            "defaultValueInternal": null
        }
